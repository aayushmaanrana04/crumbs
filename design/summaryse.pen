              "type": "text",
              "id": "KOeox",
              "name": "Body",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A carrel is the private study desk in a library: a quiet, walled-off place to read and keep your notes. The mark should feel the same — calm, monochrome, rounded like the rest of Soft neutral, and legible at 16px in the Chrome toolbar.",
              "lineHeight": 1.55,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "normal"
            }
