                                      "y": 11.058536585365852,
                                      "geometry": "M4.8475 0c-1.05 0-2.0475 0.035-2.9225 0.0875-1.1025 0.0875-1.855 0.84-1.855 1.89l-0.07 17.3075c1.8725-0.28001 3.78-0.42 5.6875-0.42 6.86 0 12.8275 2.2225 16.4675 5.1625l0-14.805c0-2.1525-6.125-9.2225-17.3075-9.2225z",
